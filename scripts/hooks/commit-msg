#!/usr/bin/env bash
# Global git hook: strip AI attribution from commit messages.
# Installed via: git config --global core.hooksPath ~/.git-hooks

MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")

PATTERNS=(
    "Co-Authored-By:.*[Cc]laude"
    "Co-Authored-By:.*[Aa]nthropic"
    "Co-Authored-By:.*[Aa]I"
    "Generated with Claude"
    "Generated by Claude"
    "Generated by AI"
    "Generated with AI"
    "AI-assisted"
    "AI assisted"
    "claude\.ai"
    "🤖"
)

FOUND=0
for p in "${PATTERNS[@]}"; do
    if echo "$MSG" | grep -qiE "$p"; then
        echo "git-hook: removing AI attribution matching '$p'"
        FOUND=1
    fi
done

if [ "$FOUND" -eq 1 ]; then
    # Strip matching lines and write back
    CLEANED=$(echo "$MSG" | grep -viE "$(IFS='|'; echo "${PATTERNS[*]}")")
    echo "$CLEANED" > "$MSG_FILE"
    echo "git-hook: commit message cleaned — AI attribution removed"
fi

exit 0
